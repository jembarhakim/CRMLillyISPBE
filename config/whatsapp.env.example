# Select one driver: local, fonnte, or meta.
WHATSAPP_DRIVER=meta

# Meta WhatsApp Cloud API
WHATSAPP_META_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# Fonnte alternative
# WHATSAPP_DRIVER=fonnte
# WHATSAPP_FONNTE_URL=https://api.fonnte.com/send
# WHATSAPP_FONNTE_TOKEN=your_fonnte_token_here

# Local whatsapp-web.js alternative
# WHATSAPP_DRIVER=local
# WHATSAPP_SERVICE_URL=http://localhost:3002

# Queue controls
WHATSAPP_RATE_LIMIT_PER_MINUTE=10
WHATSAPP_MAX_RETRIES=5
APP_BASE_URL=https://your-crm-domain.example

# Delivery status callback secret; use the same value in whatsapp-service.
WHATSAPP_STATUS_WEBHOOK_TOKEN=replace_with_a_long_random_value
WHATSAPP_STATUS_WEBHOOK_URL=http://localhost:3001/api/webhook/wa/status
